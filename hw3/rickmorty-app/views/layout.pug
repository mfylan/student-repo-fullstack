doctype html
html
  head
    title Rick and Morty
    style.
      body { font-family: sans-serif; max-width: 900px; margin: 0 auto; padding: 1rem; }
      nav a { margin-right: 1rem; }
      .card { display: inline-block; width: 200px; margin: 0 1rem 1rem 0; vertical-align: top; }
      .card img { width: 100%; }
  body
    nav
      a(href="/home") Home
      a(href="/characters") Characters
      a(href="/species") Species
      a(href="/locations") Locations
    block content
